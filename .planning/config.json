{
  "project": {
    "name": "theoretical-basis",
    "version": "1.1.0",
    "description": "Evidence-gated scientific algorithm iteration Skill",
    "repository": "https://github.com/2533598727/-theoretical-basis.skill"
  },
  "mode": "interactive",
  "granularity": "coarse",
  "workflow": {
    "auto_commit": true,
    "commit_message_template": "feat: {phase}-{plan}: {description}",
    "require_verification": true,
    "verification_types": ["automated", "manual", "integration"],
    "create_summaries": true,
    "update_state": true,
    "research": false,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "discuss_mode": "discuss"
  },
  "quality": {
    "test_coverage_threshold": 100,
    "require_linting": false,
    "require_type_checking": false,
    "require_formatting": true,
    "code_quality_checks": ["skill-validator", "contract-validator", "eval-schema"]
  },
  "planning": {
    "commit_docs": true,
    "search_gitignored": false,
    "sub_repos": []
  },
  "git": {
    "create_tag": false
  },
  "parallelization": {
    "enabled": false,
    "plan_level": false,
    "task_level": false,
    "skip_checkpoints": false,
    "max_concurrent_agents": 1,
    "min_plans_for_parallel": 2
  },
  "gates": {
    "confirm_project": true,
    "confirm_phases": true,
    "confirm_roadmap": true,
    "confirm_breakdown": true,
    "confirm_plan": true,
    "execute_next_plan": true,
    "issues_review": true,
    "confirm_transition": true
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "verification": {
    "automated_tests": true,
    "manual_verification": true,
    "integration_tests": true,
    "performance_tests": false,
    "security_scan": true
  },
  "documentation": {
    "update_readme": true,
    "create_api_docs": false,
    "maintain_changelog": false,
    "document_decisions": true
  },
  "integrations": {
    "git": true,
    "ci_cd": true,
    "project_management": false,
    "monitoring": false
  }
}
